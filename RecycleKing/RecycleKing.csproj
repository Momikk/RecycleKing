<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>Momikk</Author>
    <Name>回收之王 RecycleKing</Name>
    <RepoUrl>https://github.com/Momikk/RecycleKing</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Momikk/RecycleKing/main/images/icon.png</IconUrl>
    <Punchline>在背包中管理自己的回收物品清单。</Punchline>
    <Description>使用游戏原生 UI 管理回收物品清单。点击背包底部的“回收废品”打开清单，右键物品通过带粉色 K 的“加入回收清单”登记；NQ/HQ 视为同一物品，支持逐项移出和清空。大国防联军“筹备稀有品”列表增加品级列。当前不执行出售、丢弃、分解或交纳操作。可通过 /recycleking 或 /rking 打开。</Description>
    <Tags>inventory;recycle;list</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CanUnloadAsync>true</CanUnloadAsync>
    <Changelog>版本 0.1.0.0&#10;· 增加背包“回收废品”入口和带粉色 K 的右键加入菜单。&#10;· 清单显示图标、名称，支持移出和清空；HQ/NQ 合并保存。&#10;· 筹备稀有品列表增加物品品级列。&#10;· 当前不自动处理或交纳物品，界面仍待游戏内验收。&#10;English&#10;· Add a native inventory button and a pink K context-menu entry.&#10;· List icons and names; remove or clear entries and save HQ/NQ together.&#10;· Show item levels in the expert delivery list.&#10;· No automatic item processing or delivery; in-game UI verification is pending.</Changelog>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/KamiToolKit/KamiToolKit.csproj" />
    <Content Include="../vendor/KamiToolKit/LICENSE" Link="licenses/KamiToolKit-MIT.txt" CopyToOutputDirectory="Always" />
    <Content Include="../images/icon.png" Link="images/icon.png" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
