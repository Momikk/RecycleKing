<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.4</Version>
    <Author>Momikk</Author>
    <Name>回收之王 RecycleKing</Name>
    <RepoUrl>https://github.com/Momikk/RecycleKing</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Momikk/RecycleKing/main/images/icon.png</IconUrl>
    <Punchline>管理回收清单，在出售界面批量出售背包废品。</Punchline>
    <Description>使用游戏原生 UI 管理回收物品清单，按拼音排序，NQ/HQ 视为同一物品。可出售时背包显示“废品回收”，点击批量出售普通背包中的清单物品；再次点击可停止。清单通过插件设置或 /rking 打开。清单物品显示粉色遮罩与 X，优先于压价之王的蓝框；支持隐藏 AutoRetainer 军票悬浮框及显示稀有品品级。</Description>
    <Tags>inventory;recycle;list</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CanUnloadAsync>true</CanUnloadAsync>
    <Changelog>版本 0.1.0.4&#10;· 修复雇员回收停在右键菜单并提示“无法核对原生出售菜单”的问题，按游戏原生“委托雇员出售物品”定位出售项。核对失败时显示具体原因。实际出售仍待游戏内验证。&#10;English&#10;· Fix retainer recycling stopping at the item menu with a native sale-menu verification error. Locate Have Retainer Sell Items using the game label. Show a specific reason if verification fails. Actual selling still requires in-game verification.</Changelog>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/KamiToolKit/KamiToolKit.csproj" />
    <Content Include="../vendor/KamiToolKit/LICENSE" Link="licenses/KamiToolKit-MIT.txt" CopyToOutputDirectory="Always" />
    <Content Include="../images/icon.png" Link="images/icon.png" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
