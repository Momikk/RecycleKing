<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.1</Version>
    <Author>Momikk</Author>
    <Name>回收之王 RecycleKing</Name>
    <RepoUrl>https://github.com/Momikk/RecycleKing</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Momikk/RecycleKing/main/images/icon.png</IconUrl>
    <Punchline>在背包中管理自己的回收物品清单。</Punchline>
    <Description>使用游戏原生 UI 管理回收物品清单，按拼音排序；NQ/HQ 视为同一物品，支持逐项移出和清空。清单内物品在背包中显示粉色遮罩与 X，优先于新版压价之王的蓝框。可隐藏 AutoRetainer 军票悬浮框，筹备稀有品列表显示物品品级。当前不自动处理物品。可通过 /recycleking 或 /rking 打开。</Description>
    <Tags>inventory;recycle;list</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CanUnloadAsync>true</CanUnloadAsync>
    <Changelog>版本 0.1.0.1&#10;· 清单按物品名称拼音排序。&#10;· 背包清单物品增加粉色遮罩与 X，优先于压价之王 0.1.0.21 的蓝框。&#10;· 增加隐藏 AutoRetainer 军票悬浮框选项，默认开启，可恢复显示；不会停止自动交纳。&#10;· 跨插件隐藏可能随版本变化失效，游戏内显示仍待验收。&#10;English&#10;· Sort the list by Chinese pinyin.&#10;· Mark listed bag items with a pink mask and X, ahead of UndercutKing 0.1.0.21 blue highlights.&#10;· Add an enabled-by-default, reversible AutoRetainer GC overlay hiding option; automatic delivery is unaffected.&#10;· Overlay compatibility may change with plugin updates; in-game appearance remains unverified.</Changelog>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/KamiToolKit/KamiToolKit.csproj" />
    <Content Include="../vendor/KamiToolKit/LICENSE" Link="licenses/KamiToolKit-MIT.txt" CopyToOutputDirectory="Always" />
    <Content Include="../images/icon.png" Link="images/icon.png" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
